# Supabase (auto-inyectadas en la Edge Function; estos valores son del stack local)
# Ejecuta `supabase start` para obtener los valores reales
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend de IA para chat, documentos y embeddings:
#   studio (default) — Google AI Studio, gratis, usa GEMINI_API_KEY
#   vertex           — Vertex AI (pago, GCP), usa VERTEX_API_KEY
# La voz (Live API) usa SIEMPRE AI Studio (tokens efímeros no existen en Vertex).
AI_BACKEND=studio

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Vertex AI — API key de GCP (Credentials → API key restringida a "Vertex AI API").
# El proyecto y la región vienen amarrados a la key; no se configuran aquí.
VERTEX_API_KEY=
